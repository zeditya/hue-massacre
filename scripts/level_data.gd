class_name LevelData
extends RefCounted
##
## LEVEL DATA - every room in the game, as plain data.
##
## There are no room scenes to click around in. Each room is a dictionary and
## `room.gd` builds the geometry from it. That keeps the whole level design in
## ONE readable file, which is much easier to explain in a video (and much
## harder to break than five hand-edited .tscn files).
##
## Coordinate system: the camera-free playfield is exactly 1280x720 with a
## 26px wall all the way around. Interior obstacles are listed per room; the
## border is generated by `border_walls()`.
##
## EACH ROOM IS A DIFFERENT SPACE, ON PURPOSE
##   Rooms are not four variations of an empty box. Architecture is used to
##   change how far a guard can SEE and how the player has to move:
##
##     ROOM 01  AN OPEN PLAZA      four pillars and two low walls, so there is
##                                 almost nowhere to break line of sight. The
##                                 lesson is that paint, not furniture, is
##                                 your cover.
##     ROOM 02  TWO LONG LANES     a horizontal lane and a vertical lane crossing
##                                 at one point, so their paint meets.
##     ROOM 03  A SPLIT SPINE      a broken central wall divides the room into
##                                 wings with two doorways, giving five guards
##                                 room to work and the player somewhere to run.
##     ROOM 04  THE ARENA          two long flanking walls and a pair of cover
##                                 blocks in the middle lane.
##
## THE COLOUR WHEEL.
## The six guard colours are exact HSV hues, written out as RGB because a
## GDScript const cannot call Color.from_hsv(). The hue of each one is in the
## comment beside it, and the game's own test suite re-derives every hue from
## the RGB values to prove the numbers below are what they claim to be.
##
##     RED     (1.00, 0.00, 0.00)   =   0 deg
##     ORANGE  (1.00, 0.50, 0.00)   =  30 deg
##     YELLOW  (1.00, 1.00, 0.00)   =  60 deg
##     GREEN   (0.00, 1.00, 0.00)   = 120 deg
##     BLUE    (0.00, 0.00, 1.00)   = 240 deg
##     PURPLE  (0.75, 0.00, 1.00)   = 285 deg
##
## COMPLEMENTARY PAIRS THAT ACTUALLY EXIST IN THE GAME (tolerance 25 deg):
##     YELLOW 60  <-> BLUE 240     gap 180, off by  0  -> YES
##     GREEN 120  <-> PURPLE 285   gap 165, off by 15  -> YES
##     ORANGE 30  <-> BLUE 240     gap 150, off by 30  -> NO  (deliberately)
##     RED 0      <-> nothing                          -> NO  (deliberately)
##
## Those last two lines are the lesson: "opposite on the wheel" is a real,
## measurable relationship, not a vibe. The whole combo system is built on it.

const PLAYFIELD: Vector2 = Vector2(1280.0, 720.0)
const WALL: float = 26.0

## Default 2D radius of a guard's body and of the player. Kept here so the
## level-validity test can check that paths never clip a wall.
const GUARD_RADIUS: float = 14.0
const BOSS_RADIUS: float = 34.0
const PLAYER_RADIUS: float = 12.0

## Seconds at the start of a room during which guards cannot fill their
## detection meter. Without this, spawning inside a patrol cone feels unfair.
const SPAWN_GRACE: float = 1.4


## The four Rect2s that make the outer wall of the playfield.
static func border_walls() -> Array:
	var w: float = WALL
	var p: Vector2 = PLAYFIELD
	return [
		Rect2(0.0, 0.0, p.x, w),                 # top
		Rect2(0.0, p.y - w, p.x, w),             # bottom
		Rect2(0.0, w, w, p.y - w * 2.0),         # left
		Rect2(p.x - w, w, w, p.y - w * 2.0),     # right
	]


## The one source of truth for "where are the walls in this room".
## Both the game (room.gd) and the test suite call this, so a level can never
## be tested against different geometry from the geometry it actually runs with
## - which is the classic way a "passing" level test becomes meaningless.
static func walls_for(room: Dictionary) -> Array:
	var walls: Array = border_walls()
	for extra in room.get("walls", []):
		walls.append(extra)
	return walls


