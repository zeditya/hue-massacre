# Godot 4+ specific ignores
.godot/
/android/

# Web export output (generated by Project > Export). Rebuild it, don't commit it.
/build/

# Local source material — not part of the game and not ours to redistribute.
# The raw pack downloads carry no licence file, and the assignment brief is not
# our work. The character art that DOES ship lives in assets/characters/ and is
# credited in assets/ATTRIBUTION.md.
*.zip
Color Theory Game Assignment Guide.pdf

# Unused third-party addon. Hue Massacre draws its fixed 1280x720 playfield
# straight to the canvas and shakes the whole world node for feedback, so it has
# no Camera2D and no use for a camera-tweening plugin. Kept on disk, excluded
# from the submitted repo.
/addons/

# The paid reference pack's screenshots, and the arena backdrops baked from
# them by tools/build_backdrops.py. The arena is allowed to LOOK like the
# reference, not to contain any of its pixels: these paintings are derived from
# artwork we do not own, so they are never committed, never exported, and the
# game draws its arena entirely in code plus licensed packs. See
# scripts/arena_art.gd (draw_backdrop) and assets/ATTRIBUTION.md.
/gpt_assist/
/assets/arenas/

# Working notes. Kept on disk for the developer, out of the public repo.
freebuff-chat-*.md

# Working notes and the LMS deliverable, not game source. The LMS file carries
# personal identifiers (name, SAP ID) and does not belong in a public repo.
# PROGRESS_SUMMARY.md is deliberately NOT ignored any more: it is the
# session-by-session log the project is maintained from, it holds no personal
# data, and the next person (or the next agent) needs it to pick the work up.
PROGRESS_REPORT.md
submission.txt
